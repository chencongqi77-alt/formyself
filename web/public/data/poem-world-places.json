nty","mapPrecision":"county","coordinate":{"x":118.7425,"y":30.946941,"displayOnly":true},"intro":"李白晚年在历阳、宣城二郡徘徊，这里保留后序明确记载的最后行旅阶段。","ambiguous":false},{"id":"dangtu","name":"当涂","historicalNames":["当涂"],"modernName":"安徽省马鞍山市当涂县","placeCategory":"county","mapPrecision":"county","coordinate":{"x":118.49,"y":31.57,"displayOnly":true},"intro":"李白前往当涂探访族人李阳冰，后序把其因病去世系于宝应元年。","ambiguous":false},{"id":"emei","name":"峨眉山","historicalNames":["峨眉山","平羌"],"modernName":"四川省乐山市峨眉山市","placeCategory":"mountain","mapPrecision":"landmark","coordinate":{"x":103.484,"y":29.601,"displayOnly":true},"intro":"《峨眉山月歌》写峨眉、平羌、清溪、三峡和渝州，是李白作品空间选读的入口。","ambiguous":false},{"id":"taohuatan","name":"桃花潭","historicalNames":["桃花潭","泾县"],"modernName":"安徽省宣城市泾县桃花潭镇","placeCategory":"building","mapPrecision":"landmark","coordinate":{"x":118.18,"y":30.55,"displayOnly":true},"intro":"《赠汪伦》题下辑注称李白游泾县桃花潭，这里只作为该诗的地点阅读入口。","ambiguous":false},{"id":"huanghelou","name":"黄鹤楼","historicalNames":["黄鹤楼","江夏"],"modernName":"湖北省武汉市武昌区一带","placeCategory":"building","mapPrecision":"landmark","coordinate":{"x":114.306,"y":30.544,"displayOnly":true},"intro":"《黄鹤楼送孟浩然之广陵》题名与诗句呈现楼、扬州和长江，是送别诗的空间入口。","ambiguous":false},{"id":"baidi","name":"白帝城","historicalNames":["白帝城"],"modernName":"重庆市奉节县白帝镇一带","placeCategory":"building","mapPrecision":"landmark","coordinate":{"x":109.51,"y":31.05,"displayOnly":true},"intro":"《早发白帝城》题名和正文写白帝城、江陵与峡江水路，本站不据此断定写作年份。","ambiguous":false},{"id":"jinan","name":"历城","historicalNames":["历城","齐"],"modernName":"山东省济南市历城区一带","placeCategory":"city","mapPrecision":"city","coordinate":{"x":117.12,"y":36.65,"displayOnly":true},"intro":"辛弃疾是齐历城人，宋史记其在金末动乱中随耿京聚兵并决定南归。","ambiguous":false},{"id":"chuzhou","name":"滁州","historicalNames":["滁州"],"modernName":"安徽省滁州市","placeCategory":"city","mapPrecision":"city","coordinate":{"x":118.315,"y":32.303,"displayOnly":true},"intro":"辛弃疾出知滁州时，宋史记州郡经兵乱凋残，他以宽征、招流散和屯田应对。","ambiguous":false},{"id":"jiangling","name":"江陵","historicalNames":["江陵","荆州"],"modernName":"湖北省荆州市