      {
        "id": "cui-hao-huanghelou",
        "personId": "cui-hao",
        "title": "黄鹤楼",
        "genre": "诗",
        "text": [
          "昔人已乘白云去，此地空余黄鹤楼。",
          "黄鹤一去不复返，白云千载空悠悠。",
          "晴川历历汉阳树，春草萋萋鹦鹉洲。",
          "日暮乡关何处是，烟波江上使人愁。"
        ],
        "evidenceIds": ["ev-place-huanghelou-cui-hao"],
        "reviewStatus": "candidate-preview"
      }
    ]
  },
